<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 상단 앱 바 -->
    <LinearLayout
        android:id="@+id/pageTopBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/gb_surface_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/page_notice_title"
            android:textColor="@color/gb_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 고정 헤더 영역 -->
    <LinearLayout
        android:id="@+id/noticeHeaderArea"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toBottomOf="@id/pageTopBar">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/page_notice_title"
            android:textColor="@color/gb_on_surface"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/page_notice_subtitle"
            android:textColor="@color/gb_on_surface_variant"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/buttonNoticeFilterAll"
                style="@style/NoticeFilterActive"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/tab_all" />

            <TextView
                android:id="@+id/buttonNoticeFilterAcademic"
                style="@style/NoticeFilter"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/tab_academic" />

            <TextView
                android:id="@+id/buttonNoticeFilterScholarship"
                style="@style/NoticeFilter"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="@string/tab_scholarship" />
        </LinearLayout>
    </LinearLayout>

    <!-- 공지사항 리스트 (0dp와 weight를 사용하여 화면의 남은 공간을 꽉 채움) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/noticeRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/buttonNoticeMore"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/noticeHeaderArea" />

    <TextView
        android:id="@+id/tvNoticeLoading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="공지사항을 불러오는 중입니다..."
        android:textColor="@color/gb_on_surface_variant"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/noticeRecyclerView"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/noticeRecyclerView" />

    <!-- 더보기 버튼 (리스트 아래에 고정) -->
    <TextView
        android:id="@+id/buttonNoticeMore"
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:layout_margin="20dp"
        android:background="@drawable/bg_primary_card"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="@string/more_button"
        android:textColor="@color/gb_on_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />

    <!-- 하단 네비게이션 -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
