<?xml version="1.0" encoding="utf-8"?>
<!-- 학사공지 화면 루트 레이아웃: 공지 목록 화면 전체 기준 View -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <!-- 공지 화면 상단 앱 바: 제목만 표시 -->
    <LinearLayout
        android:id="@+id/pageTopBar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:background="@color/gb_surface_low"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/page_notice_title"
            android:textColor="@color/gb_on_surface"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pageTopBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/page_notice_title"
                android:textColor="@color/gb_on_surface"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/page_notice_subtitle"
                android:textColor="@color/gb_on_surface_variant"
                android:textSize="16sp" />

            <TextView
                style="@style/DummyBadge"
                android:layout_marginTop="16dp"
                android:text="@string/dummy_data_badge" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/dummy_data_notice"
                android:textColor="@color/gb_on_surface_variant"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/buttonNoticeFilterAll"
                    style="@style/NoticeFilterActive"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/tab_all" />

                <TextView
                    android:id="@+id/buttonNoticeFilterAcademic"
                    style="@style/NoticeFilter"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/tab_academic" />

                <TextView
                    android:id="@+id/buttonNoticeFilterScholarship"
                    style="@style/NoticeFilter"
                    android:layout_marginStart="10dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/tab_scholarship" />
            </LinearLayout>

            <!-- DUMMY DATA: Replace static notice cards with backend notice list later. -->
            <LinearLayout
                android:id="@+id/cardNoticeDummyGeneral1"
                style="@style/NoticeCardFeatured"
                android:layout_marginTop="28dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NoticeBadgeBlue"
                        android:text="@string/notice_badge_general" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/notice_scrap"
                        android:textColor="@color/gb_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/NoticeDate"
                        android:text="@string/notice_page_date_1" />
                </LinearLayout>

                <TextView
                    style="@style/NoticeTitleLarge"
                    android:text="@string/notice_page_title_1" />

                <TextView
                    style="@style/NoticeSummary"
                    android:text="@string/notice_page_body_1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNoticeDummyAcademic1"
                style="@style/NoticeCard"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NoticeBadge"
                        android:text="@string/tab_academic" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/NoticeDate"
                        android:text="@string/notice_page_date_2" />
                </LinearLayout>

                <TextView
                    style="@style/NoticeTitleLarge"
                    android:text="@string/notice_page_title_2" />

                <TextView
                    style="@style/NoticeSummary"
                    android:text="@string/notice_page_body_2" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNoticeDummyScholarship1"
                style="@style/NoticeCard"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NoticeBadge"
                        android:text="@string/tab_scholarship" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/NoticeDate"
                        android:text="@string/notice_page_date_3" />
                </LinearLayout>

                <TextView
                    style="@style/NoticeTitleLarge"
                    android:text="@string/notice_page_title_3" />

                <TextView
                    style="@style/NoticeSummary"
                    android:text="@string/notice_page_body_3" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardNoticeDummyGeneral2"
                style="@style/NoticeCard"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/NoticeBadge"
                        android:text="@string/notice_badge_general" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        style="@style/NoticeDate"
                        android:text="@string/notice_page_date_4" />
                </LinearLayout>

                <TextView
                    style="@style/NoticeTitleLarge"
                    android:text="@string/notice_page_title_4" />

                <TextView
                    style="@style/NoticeSummary"
                    android:text="@string/notice_page_body_4" />
            </LinearLayout>

            <TextView
                android:id="@+id/buttonNoticeMore"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_primary_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/more_button"
                android:textColor="@color/gb_on_primary"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

    <!-- 하단 네비게이션: 공지 화면에서도 공통 페이지 이동 유지 -->
    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
