<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="10dp">

    <LinearLayout
        style="@style/ContactCard"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical">

        <!-- 센터명 + HITS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvWindRank"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@drawable/bg_chip_active"
                android:gravity="center"
                android:textColor="@color/gb_on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvWindInstitution"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/gb_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWindHits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gb_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 제목 -->
        <TextView
            android:id="@+id/tvWindTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gb_on_surface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- 신청기간 -->
        <TextView
            android:id="@+id/tvWindApplyPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gb_on_surface_variant"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <!-- 운영기간 -->
        <TextView
            android:id="@+id/tvWindPeriod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/gb_on_surface_variant"
            android:textSize="12sp" />

    </LinearLayout>
</LinearLayout>
