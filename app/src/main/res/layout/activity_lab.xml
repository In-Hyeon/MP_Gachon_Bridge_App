<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111318">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 상단바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="&lt;"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="LAB"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Search"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 제목 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="연구소 안내"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtLabSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:text="가천대학교 AI/SW학부 연구실을 탐색해보세요."
                android:textColor="#A8A8A8"
                android:textSize="12sp" />

            <!-- 학과 선택 탭 -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnTabAi"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginRight="8dp"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:text="AI/SW학부"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTabBusiness"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginRight="8dp"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:text="경영학과"
                        android:textAllCaps="false"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/btnTabChem"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@null"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingLeft="18dp"
                        android:paddingRight="18dp"
                        android:text="화학과"
                        android:textAllCaps="false"
                        android:textSize="12sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 교수님 이름 검색 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/editSearchProfessor"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="#24262E"
                    android:gravity="center_vertical"
                    android:hint="교수님 이름 검색"
                    android:imeOptions="actionSearch"
                    android:inputType="textPersonName"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#888888"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnSearchProfessor"
                    android:layout_width="72dp"
                    android:layout_height="44dp"
                    android:layout_marginLeft="8dp"
                    android:background="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="검색"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 전체 / 즐겨찾기 탭 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnViewAll"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginRight="8dp"
                    android:background="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="전체"
                    android:textAllCaps="false"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnViewFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:background="@null"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingLeft="18dp"
                    android:paddingRight="18dp"
                    android:text="즐겨찾기"
                    android:textAllCaps="false"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 연구실 카드가 Java에서 자동으로 들어가는 영역 -->
            <LinearLayout
                android:id="@+id/labListLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 4명씩 더 보기 버튼 -->
            <Button
                android:id="@+id/btnMoreLabs"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:background="@null"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="연구소 더보기"
                android:textAllCaps="false"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/bottomNav"
        layout="@layout/view_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom" />

</FrameLayout>
