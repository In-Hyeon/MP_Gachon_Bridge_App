<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/NoticeCard"
    android:id="@+id/noticeItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNoticeBadge"
            style="@style/NoticeBadge" />

        <ImageView
            android:id="@+id/ivNoticePick"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/pin"
            android:visibility="gone" />

        <Space
            android:id="@+id/noticeBadgeSpace"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvNoticeDate"
            style="@style/NoticeDate" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoticeTitle"
        style="@style/NoticeTitleLarge" />

    <TextView
        android:id="@+id/tvNoticeSummary"
        style="@style/NoticeSummary"
        android:visibility="gone" />
</LinearLayout>
