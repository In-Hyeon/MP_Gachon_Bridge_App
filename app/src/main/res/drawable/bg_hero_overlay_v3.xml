<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 기본 테두리 및 라운딩 (가장 밑바닥) -->
    <item>
        <shape>
            <stroke
                android:width="1.5dp"
                android:color="@color/gb_outline_variant" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- 1단계: 하단 완전 불투명 영역 (하단 70%를 완전히 덮음) -->
    <item android:top="100dp">
        <shape>
            <solid android:color="@color/gb_surface" />
            <corners 
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="16dp"
                android:bottomRightRadius="16dp" />
        </shape>
    </item>

    <!-- 2단계: 상단 부드러운 그라데이션 (사진과 자연스럽게 연결) -->
    <item android:bottom="150dp">
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/gb_surface"
                android:startColor="@android:color/transparent" />
        </shape>
    </item>
</layer-list>
